// a runtime overlay, a prebuilt apk may not be copied
prebuilt_etc {
    name: "AospWifiOverlay_Marlin3",
    src: "proprietary/vendor/overlay/AospWifiOverlay_Marlin3.apk",
    sub_dir: "overlay",
    filename: "AospWifiOverlay_Marlin3.apk",
    prebuilt_strip: {
        strip: false,
    },
    vendor: {
        enabled: true,
    },
}

